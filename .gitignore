# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/DexOTR
*.dex

# Java class files
*.class

# Generated files
/gen/
/out/

# Generated SvelteKit bundle copied into APK assets by the copyWebAssets pre-build task
/app/src/main/assets/www/

# Gradle files
.gradle/
/build/

# Local configuration file (sdk path, etc.)
local.properties

# Proguard folder generated by Android Studio
/proguard/

# Log Files
*.log

# Local Pi subagent review/run artifacts
/.pi-subagents/

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures directory
/captures/

# IntelliJ IDEA
*.iml
.idea/
!.idea/codeStyles/
!.idea/inspectionProfiles/

# Android Studio 3.1+ serialized cache files
/.idea/caches/
/.idea/libraries/

# Google Services (e.g. Crashlytics or Firebase)
google-services.json
GoogleService-Info.plist

# Keystore files
*.jks
*.p12
*.pfx
*.keystore

# External native build folder
.externalNativeBuild/
.cxx/

# Native build outputs
**/src/main/cpp/*.so
**/src/main/cpp/*.a

# OS generated files
.DS_Store
Thumbs.db

# Secrets and credentials
*.pem
*.key
secrets/
.env
.env.*

# Test coverage
/coverage/
jacoco/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
dep/
!dep/boost-sha256.txt

# WebUI build artifacts
/web/.output/
/web/build/
/web/node_modules/
/web/.svelte-kit/
/web/test-results/
