# EditorConfig: https://EditorConfig.org
root = true

[*]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
charset = utf-8

# Kotlin
[*.kt]
indent_size = 4

# Kotlin Compose previews
[**/preview*.kt]
indent_size = 4

# Gradle Kotlin DSL
[*.gradle.kts]
indent_size = 4

# Gradle properties
[gradle.properties]
indent_size = 4

# C/C++ (native code)
[*.{c,cpp,h,hpp}]
indent_size = 2

# CMake
[CMakeLists.txt]
indent_size = 2

# XML (Android resources, manifests)
[*.{xml}]
indent_size = 2

# Markdown
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# JSON
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# TOML (version catalogs)
[*.toml]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2
